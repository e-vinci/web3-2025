// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Web3 Course (Node.js 24)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },
    "ghcr.io/devcontainers-extra/features/act:1": {
      "version": "v0.2.89"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "chromium"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [4321],
  // Persist Claude Code settings/chat history/memory (~/.claude) across container rebuilds:
  // named volumes survive "Rebuild Container", unlike anything not bind-mounted from the host.
  "mounts": ["source=web3-2025-claude-code-config,target=/home/node/.claude,type=volume"],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "unifiedjs.vscode-mdx",
        "yzhang.markdown-all-in-one",
        "eamodio.gitlens",
        "Prisma.prisma",
        "humao.rest-client",
        "redhat.vscode-yaml",
        "bradlc.vscode-tailwindcss",
        "marp-team.marp-vscode",
        "GraphQL.vscode-graphql",
        "Anthropic.claude-code"
      ]
    }
  }
  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
