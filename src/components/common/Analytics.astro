---
import { ANALYTICS } from 'astrowind:config';

const googleAnalytics = ANALYTICS?.vendors?.googleAnalytics;
const id = googleAnalytics?.id;
const attrs = googleAnalytics?.partytown ? { type: 'text/partytown' } : {};
const analyticsScript = id
  ? `window.dataLayer = window.dataLayer || [];
function gtag() {
  window.dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', ${JSON.stringify(id)});`
  : '';
---

{
  id ? (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} {...attrs} />

      <script is:inline {...attrs} set:html={analyticsScript} />
    </>
  ) : null
}
