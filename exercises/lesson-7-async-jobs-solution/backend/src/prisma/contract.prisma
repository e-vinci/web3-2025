// use prisma-8
model User {
  id                   Int        @id @default(autoincrement())
  name                 String
  email                String     @unique
  passwordHash         String
  bankAccount          String? // optional

  paidExpenses         Expense[]  @relation("PayerExpenses")
  participatedExpenses Expense[]  @relation("ParticipantExpenses")
  transfersOut         Transfer[] @relation("UserTransfersSource")
  transfersIn          Transfer[] @relation("UserTransfersTarget")
  exports              Export[]

  @@map("user")
}

model Expense {
  id           Int               @id @default(autoincrement())
  description  String
  amount       Float
  date         TimestamptzString @default(now())
  payer        User              @relation("PayerExpenses", fields: [payerId], references: [id])
  payerId      Int
  participants User[]            @relation("ParticipantExpenses")
  categoryId   Int?
  category     Category?         @relation(fields: [categoryId], references: [id])

  @@map("expense")
}

model Participations {
  expenseId Int
  userId    Int
  expense   Expense @relation("ParticipantExpenses", fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation("ParticipantExpenses", fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@map("participations")
}

model Transfer {
  id       Int               @id @default(autoincrement())
  amount   Float
  date     TimestamptzString @default(now())
  source   User              @relation("UserTransfersSource", fields: [sourceId], references: [id])
  sourceId Int
  target   User              @relation("UserTransfersTarget", fields: [targetId], references: [id])
  targetId Int

  @@map("transfer")
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String @unique
  colour String

  @@map("category")
}

model Export {
  id          Int               @id @default(autoincrement())
  requester   User              @relation(fields: [requesterId], references: [id])
  requesterId Int
  status      String            @default("queued")
  rowCount    Int?
  // The generated file itself. A text column is the simplest thing that works
  // and keeps one row as the whole truth about one export.
  //
  // It is not what you would do in production: reports grow, and a database is
  // an expensive place to keep bytes nobody queries. Real systems put the file
  // in an object store (S3, R2, GCS) and keep only its key here.
  csv         String?
  failedReason String?
  createdAt   TimestamptzString @default(now())

  @@map("export")
}
