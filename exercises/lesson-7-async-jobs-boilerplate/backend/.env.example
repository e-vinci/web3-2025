# Copy this file to .env and fill in the values. .env is gitignored.
DATABASE_URL="postgresql://expenso:expenso@localhost:5432/expenso"

# Signs and verifies the JWTs handed out by /api/auth/login and /api/auth/register.
# Any long random string will do locally. On Render, set a different one, and never
# reuse this value: anyone who knows your secret can mint a token for any user.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the job queue, the job events and the finished CSV files live.
# Locally this is the valkey service in docker-compose.yml. On Render, create a
# Key Value instance and paste its *internal* connection string here.
REDIS_URL="redis://localhost:6379"
