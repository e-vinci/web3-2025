{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch app.ts",
    "build": "npm install && npm run contract:emit && npx prisma db update",
    "start": "node app.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "prisma": "^8.0.0-rc.15",
    "typescript": "^7.0.2"
  }
}
