---
import merge from 'lodash.merge';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph, MetaDataTwitter } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

interface SeoProps {
  title: string;
  titleTemplate: string;
  canonical: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  openGraph: MetaDataOpenGraph;
  twitter: MetaDataTwitter;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots: robotsInput = {},
  description,
  openGraph: openGraphInput = {},
  twitter = {},
} = Astro.props;

const seoProps: SeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraphInput?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robotsInput?.index !== 'undefined' ? !robotsInput.index : undefined,
    nofollow: typeof robotsInput?.follow !== 'undefined' ? !robotsInput.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraphInput },
    twitter: twitter,
  }
);

const resolvedOpenGraph = await adaptOpenGraphImages(seoProps.openGraph, Astro.site);
const pageTitle = seoProps.titleTemplate ? seoProps.titleTemplate.replace('%s', seoProps.title) : seoProps.title;
const robotsContent = [
  typeof seoProps.noindex !== 'undefined' ? (seoProps.noindex ? 'noindex' : 'index') : undefined,
  typeof seoProps.nofollow !== 'undefined' ? (seoProps.nofollow ? 'nofollow' : 'follow') : undefined,
]
  .filter(Boolean)
  .join(',');
const openGraphTitle = resolvedOpenGraph.title ?? seoProps.title;
const openGraphDescription = resolvedOpenGraph.description ?? seoProps.description;
const siteName = resolvedOpenGraph.site_name ?? resolvedOpenGraph.siteName;
---

{pageTitle && <title>{pageTitle}</title>}
{seoProps.description && <meta name="description" content={seoProps.description} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{seoProps.canonical && <link rel="canonical" href={seoProps.canonical} />}

{openGraphTitle && <meta property="og:title" content={openGraphTitle} />}
{openGraphDescription && <meta property="og:description" content={openGraphDescription} />}
{resolvedOpenGraph.url && <meta property="og:url" content={resolvedOpenGraph.url} />}
{resolvedOpenGraph.type && <meta property="og:type" content={resolvedOpenGraph.type} />}
{
  resolvedOpenGraph.images?.map((image) => (
    <>
      {image.url && <meta property="og:image" content={image.url} />}
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
    </>
  ))
}
{resolvedOpenGraph.locale && <meta property="og:locale" content={resolvedOpenGraph.locale} />}
{siteName && <meta property="og:site_name" content={siteName} />}

{seoProps.twitter.cardType && <meta name="twitter:card" content={seoProps.twitter.cardType} />}
{seoProps.twitter.site && <meta name="twitter:site" content={seoProps.twitter.site} />}
{seoProps.twitter.handle && <meta name="twitter:creator" content={seoProps.twitter.handle} />}
