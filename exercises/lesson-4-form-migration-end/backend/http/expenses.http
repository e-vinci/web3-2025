@server = http://localhost:3000
@expenses = {{server}}/api/expenses

### Get all expenses
GET {{expenses}}

### Get by amount
GET {{expenses}}?amount=45

### Get by payer
GET {{expenses}}?payerId=1

### Get by payer and amount
GET {{expenses}}?payerId=1&amount=3.5

### Add a new expense
POST {{expenses}}
Content-Type: application/json

{
  "date": "2025-10-15",
  "description": "Team lunch",
  "payer": "John",
  "amount": 45.50,
  "categoryId": 1
}

### Reset expenses
POST {{expenses}}/reset
